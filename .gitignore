node_modules/

# Build output. Globbed rather than listed per package so a new package never
# ends up with a stale dist/ committed and published in place of a real build.
/packages/*/dist/
/packages/clients/lib/

# OS files
.DS_Store

# Generated TypeScript declaration files in source directories (exclude react-app-env.d.ts)
packages/*/src/**/[A-Z]*.d.ts

# Nx cache
.nx/

# Debug logs
lerna-debug.log
npm-debug.log*
/packages/core/plans/
